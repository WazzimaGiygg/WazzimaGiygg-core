{
  "entities": {
    "Article": {
      "title": "Article",
      "description": "Public articles and encyclopedic knowledge publications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titulo": { "type": "string", "maxLength": 300 },
        "descricao": { "type": "string" },
        "setor": { "type": "string", "maxLength": 100 },
        "criadorEmail": { "type": "string" },
        "colecao": { "type": "string" },
        "visualizacoes": { "type": "number" }
      },
      "required": ["titulo", "descricao"]
    },
    "User": {
      "title": "User",
      "description": "User profile and verified server/bureaucrat-managed permissions",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "isTeacher": { "type": "boolean" },
        "isBanned": { "type": "boolean" },
        "notMediaWikiPageSlug": { "type": "string" },
        "notMediaWikiPageCreated": { "type": "boolean" }
      },
      "required": ["uid"]
    },
    "UserPage": {
      "title": "UserPage",
      "description": "Public NotMediaWiki personal page (Namespace 2) without raw e-mail PII",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "ownerUid": { "type": "string" },
        "ownerName": { "type": "string" },
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "wikitext": { "type": "string" },
        "isPersonalUserPage": { "type": "boolean" }
      },
      "required": ["ownerUid", "slug", "wikitext"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "LGPD and Ouvidoria ticket submitted by a visitor or authenticated titular",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requesterUid": { "type": "string" },
        "nome": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 200 },
        "tipo": { "type": "string" },
        "mensagem": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string" },
        "criadoEm": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "mensagem"]
    },
    "LgpdDeletionRequest": {
      "title": "LgpdDeletionRequest",
      "description": "LGPD Art. 18 data deletion request restricted to Burocrata/DPO processing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "reason": { "type": "string" },
        "dataTypes": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" },
        "requestDate": { "type": "string", "format": "date-time" },
        "processedBy": { "type": "string" },
        "certificateId": { "type": "string" }
      },
      "required": ["email", "status"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only security and compliance audit event (LGPD Art. 37 / Marco Civil Art. 15)",
      "type": "object",
      "properties": {
        "action": { "type": "string", "maxLength": 200 },
        "userId": { "type": "string" },
        "details": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["action"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification document scoped by userId or global broadcast",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "titulo": { "type": "string" },
        "mensagem": { "type": "string" },
        "lida": { "type": "boolean" }
      },
      "required": ["userId"]
    },
    "BemteviPost": {
      "title": "BemteviPost",
      "description": "Microblogging post on the Bem-Te-Vi social network (max 127 chars)",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorHandle": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "authorBadge": { "type": "string" },
        "authorKarma": { "type": "number" },
        "content": { "type": "string", "maxLength": 127 },
        "link": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" },
        "communityId": { "type": "string" },
        "communityName": { "type": "string" },
        "sharedArticle": { "type": "object" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "sharesCount": { "type": "number" },
        "savesCount": { "type": "number" },
        "likedBy": { "type": "array", "items": { "type": "string" } },
        "savedBy": { "type": "array", "items": { "type": "string" } },
        "isEdited": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorName", "content", "category"]
    },
    "BemteviComment": {
      "title": "BemteviComment",
      "description": "Public comment on a Bem-Te-Vi post (max 280 chars)",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorHandle": { "type": "string" },
        "content": { "type": "string", "maxLength": 280 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "authorId", "content"]
    },
    "BemteviCommunity": {
      "title": "BemteviCommunity",
      "description": "Topic-based community in Bem-Te-Vi",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 300 },
        "category": { "type": "string" },
        "membersCount": { "type": "number" },
        "postsCount": { "type": "number" },
        "createdBy": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "createdBy", "category"]
    },
    "BemteviDirectMessage": {
      "title": "BemteviDirectMessage",
      "description": "Private direct message between Bem-Te-Vi users",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "receiverId": { "type": "string" },
        "text": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["conversationId", "senderId", "receiverId", "text"]
    }
  },
  "firestore": {
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Public articles readable by all visitors"
    },
    "/artigos/{articleId}": {
      "schema": "Article",
      "description": "Portal publications catalog"
    },
    "/wikiworldweb/{articleId}": {
      "schema": "Article",
      "description": "News and world web articles"
    },
    "/academico/{articleId}": {
      "schema": "Article",
      "description": "Academic and methodology papers"
    },
    "/materiadeensaio/{articleId}": {
      "schema": "Article",
      "description": "Essay articles"
    },
    "/materia/{articleId}": {
      "schema": "Article",
      "description": "Subject articles"
    },
    "/uwgbooks/{articleId}": {
      "schema": "Article",
      "description": "UWG Books publications"
    },
    "/documentos/{docId}": {
      "schema": "Article",
      "description": "Editorial and compliance documents"
    },
    "/wiki_articles/{slug}": {
      "schema": "Article",
      "description": "NotMediaWiki articles"
    },
    "/wiki_revisions/{revId}": {
      "schema": "Article",
      "description": "NotMediaWiki article revisions"
    },
    "/wiki_events/{eventId}": {
      "schema": "Article",
      "description": "NotMediaWiki EventStream history"
    },
    "/wiki_extensions/{extId}": {
      "schema": "Article",
      "description": "NotMediaWiki extension registry (Burocrata managed)"
    },
    "/extensions_integrity_registry/{extId}": {
      "schema": "Article",
      "description": "Cryptographic integrity metadata for extensions"
    },
    "/userpage/{userId}": {
      "schema": "UserPage",
      "description": "Public personal Wiki user page without private email PII"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User accounts and Burocrata-protected role flags"
    },
    "/usuários/{userId}": {
      "schema": "User",
      "description": "Localized user accounts mirror with same least-privilege protections"
    },
    "/notifications/{notifId}": {
      "schema": "Notification",
      "description": "User-scoped portal notifications"
    },
    "/tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Ouvidoria & LGPD tickets isolated to requester and Burocrata"
    },
    "/deletion_requests/{reqId}": {
      "schema": "LgpdDeletionRequest",
      "description": "LGPD Art. 18 data deletion queue (write-only create, Burocrata-only read/process)"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Append-only security audit log (Burocrata-only read)"
    },
    "/checkuser/{logId}": {
      "schema": "AuditLog",
      "description": "Append-only CheckUser access/audit log (Burocrata-only read)"
    },
    "/bemtevi_posts/{postId}": {
      "schema": "BemteviPost",
      "description": "Public Bem-Te-Vi social feed posts"
    },
    "/bemtevi_comments/{commentId}": {
      "schema": "BemteviComment",
      "description": "Comments attached to Bem-Te-Vi posts"
    },
    "/bemtevi_communities/{communityId}": {
      "schema": "BemteviCommunity",
      "description": "Bem-Te-Vi thematic communities"
    },
    "/bemtevi_messages/{messageId}": {
      "schema": "BemteviDirectMessage",
      "description": "Private Bem-Te-Vi direct messages"
    }
  }
}
